{
  "name": "the-arena-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "create-admin": "ts-node-dev --transpile-only src/scripts/createAdmin.ts",
    "create-admin:prod": "node dist/scripts/createAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:phase2": "ts-node-dev --transpile-only src/scripts/migratePhase2.ts",
    "migrate:phase2:prod": "node dist/scripts/migratePhase2.js",
    "migrate:rbac": "ts-node-dev --transpile-only src/scripts/migrateRbac.ts",
    "migrate:rbac:prod": "node dist/scripts/migrateRbac.js",
    "migrate:profiles": "ts-node-dev --transpile-only src/scripts/migrateProfiles.ts",
    "migrate:profiles:prod": "node dist/scripts/migrateProfiles.js",
    "migrate:teams": "ts-node-dev --transpile-only src/scripts/migrateTeams.ts",
    "migrate:teams:prod": "node dist/scripts/migrateTeams.js",
    "migrate:tournaments": "ts-node-dev --transpile-only src/scripts/migrateTournaments.ts",
    "migrate:tournaments:prod": "node dist/scripts/migrateTournaments.js",
    "migrate:grounds": "ts-node-dev --transpile-only src/scripts/migrateGrounds.ts",
    "migrate:grounds:prod": "node dist/scripts/migrateGrounds.js",
    "migrate:subscriptions": "ts-node-dev --transpile-only src/scripts/migrateSubscriptions.ts",
    "migrate:subscriptions:prod": "node dist/scripts/migrateSubscriptions.js",
    "migrate:shop": "ts-node-dev --transpile-only src/scripts/migrateShop.ts",
    "migrate:shop:prod": "node dist/scripts/migrateShop.js",
    "seed:demo": "ts-node-dev --transpile-only src/scripts/seedDemo.ts",
    "seed:demo:prod": "node dist/scripts/seedDemo.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
