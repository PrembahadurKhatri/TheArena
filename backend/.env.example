# ---------------------------------------------------------------------------
# The Arena backend — copy to .env for local development.
# On Render, set these in the dashboard (Environment tab), NOT in a file.
# Never commit real values.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# Render sets PORT automatically — don't set it there.
PORT=5050

# Local:  mongodb://localhost:27017/thearena
# Atlas:  mongodb+srv://<db-user>:<db-password>@<cluster-host>/thearena?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/thearena
# Optional: only used if MONGO_URI doesn't include a database name.
MONGO_DB_NAME=
# Optional: connection pool size (default 10).
MONGO_MAX_POOL_SIZE=

# At least 32 random characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# Optional: token lifetime (default 7d).
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
# The first one is used in password-reset email links.
# e.g. https://the-arena.vercel.app,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173

# Payments: "test" lets the logged-in user confirm their own payment with no
# real gateway (sandbox). Defaults to "test" in development and DISABLED in
# production. Setting PAYMENT_MODE=test in production means anyone can get
# premium / confirm bookings and orders without paying — only do that for a
# demo, never with real customers.
PAYMENT_MODE=

# Password reset emails. If SMTP_HOST is blank, reset links are logged to
# the server console instead of emailed.
# Resend: host smtp.resend.com, user "resend", password = your Resend API key.
# Use port 2587 — Render's free tier blocks outbound 25/465/587.
# SMTP_FROM must be on a domain verified in Resend; until then only
# onboarding@resend.dev works, and it only delivers to your own Resend
# account's email address.
SMTP_HOST=
SMTP_PORT=2587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TheArena <onboarding@resend.dev>

# Membership pricing (plain NPR amounts)
MEMBERSHIP_MONTHLY_PRICE=299
MEMBERSHIP_YEARLY_PRICE=2999

# Image uploads -> Cloudinary (cloudinary.com -> Dashboard). Required in
# production (Render's disk is wiped on every deploy/restart). Leave blank
# locally to store uploads on disk in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Cloudinary folder for this app's images (default "thearena").
CLOUDINARY_FOLDER=

# Optional, only when Cloudinary isn't set: where uploads go on disk
# (default backend/uploads). On Render that must be a mounted persistent
# disk path such as /var/data/uploads.
UPLOADS_DIR=

# Optional: how long unpaid bookings/orders hold a slot/stock (minutes).
BOOKING_HOLD_MINUTES=15
ORDER_HOLD_MINUTES=30
# Optional defaults; a Super Admin can change these in Admin > Settings.
# Hours before a booking starts when the booker can no longer cancel.
BOOKING_CANCEL_CUTOFF_HOURS=2
# Hours before an unanswered match result becomes official.
REPORT_AUTO_VERIFY_HOURS=72

# Optional: rate limits per IP per 15 minutes.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
# Invitations, challenges, reports, reviews, new listings per IP per 15 minutes.
ACTION_RATE_LIMIT_MAX=60

# Plan prices (NPR) used when the plan catalogue is first created. Staff edit
# them later in the admin console. Payments are on hold until a gateway exists.
TEAM_PREMIUM_PRICE=499
MERCHANT_PRO_PRICE=999

# Seed script only (npm run seed / npm run seed:prod).
# In production the demo shop is skipped unless SEED_DEMO_SHOP=true, and then
# SEED_STORE_PASSWORD is required.
SEED_DEMO_SHOP=
SEED_STORE_PASSWORD=
